# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# PostgreSQL connection string for development
DATABASE_URL=postgresql://user:password@localhost:5432/tasks_dev

# PostgreSQL connection string for integration tests
# Should point to a separate database so tests can truncate tables freely
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/tasks_test
